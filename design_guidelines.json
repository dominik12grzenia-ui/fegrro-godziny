{
  "theme": "dark",
  "archetype": "5 (Jewel & Luxury) with 4 (Swiss & High-Contrast) data tables",
  "brand_colors": {
    "background": "#0B1120",
    "surface": "#131C2F",
    "card": "#19243C",
    "primary": "#4F6343",
    "primary_hover": "#5F7552",
    "primary_light": "#6B8E4E",
    "accent_gold": "#D4AF37",
    "accent_copper": "#C78B58",
    "destructive": "#9B2C2C",
    "destructive_light": "#FCA5A5",
    "border": "#2A3B59",
    "text_primary": "#F8FAFC",
    "text_secondary": "#94A3B8",
    "text_muted": "#64748B"
  },
  "typography": {
    "headings": {
      "family": "'Cabinet Grotesk', sans-serif",
      "weights": ["400", "500", "700", "800"],
      "letter_spacing": "tracking-tight"
    },
    "body": {
      "family": "'Manrope', sans-serif",
      "weights": ["400", "500", "600", "700"]
    },
    "data_tables": {
      "family": "'JetBrains Mono', monospace",
      "features": "tabular-nums"
    }
  },
  "spacing_and_layout": {
    "grid_system": "4px base",
    "density": "Dense for Admin/Finance, Generous for Mobile/Public",
    "border_radius": "rounded-lg (12px) for cards, rounded-md (8px) for buttons/inputs"
  },
  "components": {
    "card": {
      "background": "bg-[#19243C]",
      "border": "border border-[#2A3B59]",
      "shadow": "shadow-lg shadow-black/40",
      "padding": "p-6"
    },
    "button": {
      "primary": "bg-[#4F6343] hover:bg-[#5F7552] text-white rounded-md transition-colors",
      "secondary": "bg-[#2A3B59] hover:bg-[#374B6D] text-white rounded-md transition-colors"
    },
    "finance_table": {
      "header_bg": "bg-[#131C2F]",
      "header_text": "text-[#94A3B8] text-xs uppercase tracking-wider font-semibold",
      "row_border": "border-b border-[#2A3B59]",
      "row_hover": "hover:bg-[#131C2F]/50",
      "cell_padding": "py-3 px-4",
      "numbers": "font-mono tabular-nums text-right"
    },
    "alerts": {
      "warning": "bg-[#D4AF37]/15 border border-[#D4AF37]/50 text-[#D4AF37]",
      "critical": "bg-[#9B2C2C]/20 border border-[#9B2C2C]/50 text-[#FCA5A5]"
    }
  },
  "mobile_specific": {
    "touch_targets": "min-h-[48px] min-w-[48px]",
    "font_sizes": "Base 16px to prevent iOS zoom"
  },
  "instructions_to_main_agent": [
    "Apply Manrope and JetBrains Mono fonts across the app.",
    "Update Tailwind config with the new color hexes.",
    "Refactor AdminDashboard to use Glassmorphism for the sticky header (bg-[#0B1120]/80 backdrop-blur-xl).",
    "Refactor Finance and Payroll tables to remove heavy vertical borders, use sleek horizontal borders, and apply JetBrains Mono for numbers.",
    "Ensure PublicHours mobile view has large touch targets, high contrast text for outdoor readability, and clear distinction between days."
  ]
}